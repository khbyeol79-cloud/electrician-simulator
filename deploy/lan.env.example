# Copy outside the public web directory. Never commit the completed secret file.
APP_MODE=web
APP_ENV=production
APP_DEBUG=false
ALLOW_LAN=true
AUTH_REQUIRED=true
APP_HOST=0.0.0.0
APP_PORT=8000
# Relative to the PROGRAM folder, independent of CWD/USB drive letter.
# All account/study databases belong together in this folder.
# An existing absolute path remains supported; never point inside frontend/dist.
ELECTRICIAN_DATA_DIR=user-data
# No invitation code. Set false only when new enrollment should be closed.
REGISTRATION_OPEN=true
# true when HTTPS terminates at this service/trusted reverse proxy.
AUTH_COOKIE_SECURE=false
AUTH_IDLE_SECONDS=1800
AUTH_LIFETIME_SECONDS=36000
ALLOWED_ORIGINS=
