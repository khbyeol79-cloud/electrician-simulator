{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagram.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "view_box", "sections", "elements", "conductors"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "view_box": { "$ref": "#/$defs/box" },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } },
    "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "conductors": { "type": "array", "items": { "$ref": "#/$defs/conductor" } }
  },
  "$defs": {
    "point": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
    "box": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } } },
    "section": { "type": "object", "additionalProperties": false, "required": ["section_id", "label", "bounds"], "properties": { "section_id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 }, "bounds": { "$ref": "#/$defs/box" } } },
    "element": {
      "type": "object", "additionalProperties": false,
      "required": ["element_id", "element_type", "section_id", "circuit_ref_type", "circuit_ref_id", "question_id", "x", "y", "width", "height", "orientation", "label", "interactive"],
      "properties": {
        "element_id": { "type": "string", "minLength": 1 },
        "element_type": { "enum": ["terminal", "contact_no", "contact_nc", "contact_changeover", "coil", "push_button_no", "push_button_nc", "limit_switch_no", "limit_switch_nc", "timer_contact", "magnetic_contactor", "eocr", "fuse", "mccb", "indicator_lamp", "motor", "junction", "text", "power_label", "ground"] },
        "section_id": { "type": "string", "minLength": 1 },
        "circuit_ref_type": { "type": ["string", "null"], "enum": ["device", "terminal", "contact", "coil", null] },
        "circuit_ref_id": { "type": ["string", "null"] },
        "question_id": { "type": ["string", "null"] },
        "x": { "type": "number" }, "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 },
        "orientation": { "enum": ["horizontal", "vertical"] }, "label": { "type": "string" }, "interactive": { "type": "boolean" }
      }
    },
    "conductor": {
      "type": "object", "additionalProperties": false,
      "required": ["conductor_id", "section_id", "points", "line_style", "junctions"],
      "properties": {
        "conductor_id": { "type": "string", "minLength": 1 }, "section_id": { "type": "string", "minLength": 1 },
        "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } },
        "line_style": { "enum": ["power_l1", "power_l2", "power_l3", "protective_earth", "control", "neutral", "reference"] },
        "junctions": { "type": "array", "items": { "$ref": "#/$defs/point" } }
      }
    }
  }
}
