{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem.schema.json",
  "title": "Public Problem Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "problem_id", "description", "instructions", "learning_objectives", "power_supply", "schematic", "board", "available_devices", "circuit", "socket_questions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "problem_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "instructions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "minItems": 1, "maxItems": 30 },
    "learning_objectives": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "maxItems": 30 },
    "power_supply": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "voltage", "frequency", "wire_colors"],
      "properties": {
        "system": { "type": "string", "minLength": 1, "maxLength": 60 },
        "voltage": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "frequency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "wire_colors": { "$ref": "#/$defs/wireColors" }
      }
    },
    "schematic": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "format", "view_box"],
      "properties": {
        "file": { "$ref": "#/$defs/safeRelativePath" },
        "format": { "const": "svg" },
        "view_box": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)? -?[0-9]+(?:\\.[0-9]+)? [0-9]+(?:\\.[0-9]+)? [0-9]+(?:\\.[0-9]+)?$" }
      }
    },
    "board": {
      "type": "object", "additionalProperties": false, "required": ["layout_id"],
      "properties": { "layout_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" } }
    },
    "available_devices": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "circuit": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "definition_status", "devices", "terminals", "contacts", "coils"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "definition_status": { "enum": ["structure_only", "functional"] },
        "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } },
        "terminals": { "type": "array", "items": { "$ref": "#/$defs/terminal" } },
        "contacts": { "type": "array", "items": { "$ref": "#/$defs/contact" } },
        "coils": { "type": "array", "items": { "$ref": "#/$defs/coil" } }
      }
    },
    "socket_questions": { "type": "array", "items": { "$ref": "#/$defs/socketQuestion" } },
    "device_layout": {
      "anyOf": [
        { "$ref": "#/$defs/deviceLayoutDefinition" },
        { "type": "null" }
      ]
    },
    "mounting": {
      "anyOf": [
        { "$ref": "#/$defs/mountingDefinition" },
        { "type": "null" }
      ]
    },
    "operation": {
      "anyOf": [
        { "$ref": "#/$defs/operationDefinition" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "safeRelativePath": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000]+$" },
    "wireColors": {
      "type": "object", "additionalProperties": false, "required": ["L1", "L2", "L3", "control"],
      "properties": { "L1": { "const": "brown" }, "L2": { "const": "black" }, "L3": { "const": "gray" }, "control": { "const": "yellow" } }
    },
    "boardPosition": {
      "type": "object", "additionalProperties": false, "required": ["row", "column", "x", "y"],
      "properties": { "row": { "type": "integer", "minimum": 0 }, "column": { "type": "integer", "minimum": 0 }, "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } }
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["device_id", "device_type_id", "label", "socket_type_id", "board_position", "installed_initially"],
      "properties": { "device_id": { "$ref": "#/$defs/id" }, "device_type_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" }, "label": { "$ref": "#/$defs/id" }, "socket_type_id": { "type": ["string", "null"] }, "board_position": { "$ref": "#/$defs/boardPosition" }, "installed_initially": { "type": "boolean" } }
    },
    "terminal": {
      "type": "object", "additionalProperties": false,
      "required": ["terminal_id", "device_id", "pin_number", "terminal_type", "electrical_role", "max_connections", "enabled"],
      "properties": {
        "terminal_id": { "$ref": "#/$defs/id" }, "device_id": { "$ref": "#/$defs/id" }, "pin_number": { "type": ["integer", "null"], "minimum": 1 },
        "terminal_type": { "enum": ["socket_pin", "screw_terminal", "coil_terminal", "contact_terminal", "power_terminal", "ground_terminal", "external_terminal"] },
        "electrical_role": { "enum": ["unassigned", "line", "neutral", "protective_earth", "control", "coil", "contact_common", "contact_no", "contact_nc", "load"] },
        "max_connections": { "type": "integer", "minimum": 1, "maximum": 20 }, "enabled": { "type": "boolean" }
      }
    },
    "contact": {
      "type": "object", "additionalProperties": false,
      "required": ["contact_id", "owner_device_id", "contact_type", "common_terminal_id", "switched_terminal_id", "controlled_by_coil_id", "normal_state"],
      "properties": { "contact_id": { "$ref": "#/$defs/id" }, "owner_device_id": { "$ref": "#/$defs/id" }, "contact_type": { "enum": ["NO", "NC", "CHANGEOVER"] }, "common_terminal_id": { "$ref": "#/$defs/id" }, "switched_terminal_id": { "$ref": "#/$defs/id" }, "nc_terminal_id": { "type": ["string", "null"], "maxLength": 80 }, "no_terminal_id": { "type": ["string", "null"], "maxLength": 80 }, "controlled_by_coil_id": { "$ref": "#/$defs/id" }, "normal_state": { "enum": ["open", "closed"] } }
    },
    "coil": {
      "type": "object", "additionalProperties": false,
      "required": ["coil_id", "owner_device_id", "terminal_a_id", "terminal_b_id", "rated_voltage", "voltage_type", "frequency"],
      "properties": { "coil_id": { "$ref": "#/$defs/id" }, "owner_device_id": { "$ref": "#/$defs/id" }, "terminal_a_id": { "$ref": "#/$defs/id" }, "terminal_b_id": { "$ref": "#/$defs/id" }, "rated_voltage": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }, "voltage_type": { "enum": ["AC", "DC"] }, "frequency": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000 } }
    },
    "answerSlot": {
      "type": "object", "additionalProperties": false, "required": ["slot_id", "position"],
      "properties": { "slot_id": { "type": "string", "minLength": 1, "maxLength": 40 }, "position": { "enum": ["above", "below", "left", "right"] } }
    },
    "socketQuestion": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "target_element_type", "target_element_id", "display_label", "answer_slots"],
      "properties": { "question_id": { "$ref": "#/$defs/id" }, "target_element_type": { "enum": ["contact", "coil"] }, "target_element_id": { "$ref": "#/$defs/id" }, "display_label": { "$ref": "#/$defs/id" }, "answer_slots": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/answerSlot" } } }
    },
    "mountDevice": {
      "type": "object", "additionalProperties": false,
      "required": ["mount_device_id", "label", "device_type_id", "graphic_type", "compatible_socket_type_ids"],
      "properties": {
        "mount_device_id": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:[-_][A-Za-z0-9]+)*$" },
        "label": { "$ref": "#/$defs/id" },
        "device_type_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "graphic_type": { "enum": ["relay", "timer", "contactor"] },
        "compatible_socket_type_ids": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" } }
      }
    },
    "mountTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["socket_id", "socket_type_id", "enabled", "allowed_device_type_ids"],
      "properties": {
        "socket_id": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:[-_][A-Za-z0-9]+)*$" },
        "socket_type_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "enabled": { "type": "boolean" },
        "allowed_device_type_ids": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" } }
      }
    },
    "fixedDevicePlacement": {
      "type": "object", "additionalProperties": false,
      "required": ["mount_device_id", "label", "device_type_id", "graphic_type", "socket_id", "socket_type_id"],
      "properties": {
        "mount_device_id": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:[-_][A-Za-z0-9]+)*$" },
        "label": { "$ref": "#/$defs/id" },
        "device_type_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "graphic_type": { "enum": ["relay", "timer", "contactor"] },
        "socket_id": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:[-_][A-Za-z0-9]+)*$" },
        "socket_type_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" }
      }
    },
    "deviceLayoutDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "fixed_placements"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "fixed_placements": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/fixedDevicePlacement" } }
      }
    },
    "mountingDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "available_devices", "mount_targets"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "available_devices": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/mountDevice" } },
        "mount_targets": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/mountTarget" } }
      }
    },
    "operationDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "simulation_status", "power", "controls", "timers", "indicators", "motors", "internal_connections"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "simulation_status": { "enum": ["preview", "functional"] },
        "power": {
          "type": "object", "additionalProperties": false,
          "required": ["line_terminal_id", "return_terminal_id", "phase_terminal_ids"],
          "properties": {
            "line_terminal_id": { "$ref": "#/$defs/id" },
            "return_terminal_id": { "$ref": "#/$defs/id" },
            "phase_terminal_ids": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/id" } }
          }
        },
        "controls": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/operationControl" } },
        "timers": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/operationTimer" } },
        "indicators": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/operationIndicator" } },
        "motors": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/operationMotor" } },
        "contactors": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/operationContactor" } },
        "interlocks": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/operationInterlock" } },
        "protection_devices": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/operationProtectionDevice" } },
        "direction_change_policy": { "enum": ["current_direction_first", "first_input_first", "block_both", "stop_before_reverse"] },
        "internal_connections": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/terminalPair" } }
      }
    },
    "terminalPair": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": { "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" } }
    },
    "operationControl": {
      "type": "object", "additionalProperties": false,
      "required": ["control_id", "label", "control_type", "mode", "contact_type", "terminal_a_id", "terminal_b_id", "initial_active"],
      "properties": {
        "control_id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/id" },
        "control_type": { "enum": ["pushbutton", "limit_switch", "selector"] },
        "mode": { "enum": ["momentary", "maintained"] }, "contact_type": { "enum": ["NO", "NC"] },
        "terminal_a_id": { "$ref": "#/$defs/id" }, "terminal_b_id": { "$ref": "#/$defs/id" },
        "initial_active": { "type": "boolean" }
      }
    },
    "operationTimer": {
      "type": "object", "additionalProperties": false,
      "required": ["timer_id", "label", "coil_id", "mode", "delay_ms", "timed_contact_ids", "retentive"],
      "properties": {
        "timer_id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/id" }, "coil_id": { "$ref": "#/$defs/id" },
        "mode": { "const": "on_delay" }, "delay_ms": { "type": "integer", "exclusiveMinimum": 0, "maximum": 3600000 },
        "timed_contact_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "retentive": { "type": "boolean" }
      }
    },
    "operationIndicator": {
      "type": "object", "additionalProperties": false,
      "required": ["indicator_id", "label", "display_color", "terminal_a_id", "terminal_b_id"],
      "properties": {
        "indicator_id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/id" },
        "display_color": { "enum": ["red", "green", "yellow", "white"] },
        "terminal_a_id": { "$ref": "#/$defs/id" }, "terminal_b_id": { "$ref": "#/$defs/id" }
      }
    },
    "operationMotor": {
      "type": "object", "additionalProperties": false,
      "required": ["motor_id", "label", "forward_coil_id", "reverse_coil_id", "phase_terminal_ids", "phase_source_terminal_ids", "forward_phase_order"],
      "properties": {
        "motor_id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/id" },
        "forward_coil_id": { "type": ["string", "null"], "maxLength": 80 },
        "reverse_coil_id": { "type": ["string", "null"], "maxLength": 80 },
        "phase_terminal_ids": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/id" } },
        "phase_source_terminal_ids": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/id" } },
        "forward_phase_order": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer", "minimum": 0, "maximum": 2 } }
      }
    },
    "operationContactor": {
      "type": "object", "additionalProperties": false,
      "required": ["contactor_id", "label", "coil_id", "role", "start_control_id", "motor_id"],
      "properties": {
        "contactor_id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/id" },
        "coil_id": { "$ref": "#/$defs/id" }, "role": { "enum": ["forward", "reverse", "general"] },
        "start_control_id": { "type": ["string", "null"], "maxLength": 80 },
        "motor_id": { "type": ["string", "null"], "maxLength": 80 }
      }
    },
    "operationInterlock": {
      "type": "object", "additionalProperties": false,
      "required": ["interlock_id", "label", "type", "contactor_ids", "contact_ids", "policy"],
      "properties": {
        "interlock_id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/id" },
        "type": { "enum": ["electrical", "mechanical"] },
        "contactor_ids": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "contact_ids": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "policy": { "const": "prevent_simultaneous_activation" }
      }
    },
    "operationProtectionDevice": {
      "type": "object", "additionalProperties": false,
      "required": ["protection_device_id", "label", "protection_type", "protected_coil_ids", "protected_motor_ids", "reset_mode", "allowed_fault_types"],
      "properties": {
        "protection_device_id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/id" },
        "protection_type": { "const": "eocr" },
        "protected_coil_ids": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "protected_motor_ids": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "reset_mode": { "enum": ["manual", "automatic", "restart_required"] },
        "allowed_fault_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "const": "overload" } }
      }
    }
  }
}
