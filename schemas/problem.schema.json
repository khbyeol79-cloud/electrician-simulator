{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem.schema.json",
  "title": "Public Problem Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "problem_id", "description", "instructions",
    "learning_objectives", "power_supply", "schematic", "board",
    "available_devices", "circuit", "socket_questions"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "problem_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "instructions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "minItems": 1,
      "maxItems": 30
    },
    "learning_objectives": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 200 },
      "maxItems": 30
    },
    "power_supply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "voltage", "frequency", "wire_colors"],
      "properties": {
        "system": { "type": "string", "minLength": 1, "maxLength": 60 },
        "voltage": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "frequency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "wire_colors": { "$ref": "#/$defs/wireColors" }
      }
    },
    "schematic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "format", "view_box"],
      "properties": {
        "file": { "$ref": "#/$defs/safeRelativePath" },
        "format": { "const": "svg" },
        "view_box": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)? -?[0-9]+(?:\\.[0-9]+)? [0-9]+(?:\\.[0-9]+)? [0-9]+(?:\\.[0-9]+)?$"
        }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_id"],
      "properties": {
        "layout_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" }
      }
    },
    "available_devices": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "circuit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["devices", "terminals", "contacts", "coils"],
      "properties": {
        "devices": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "terminals": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "contacts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "coils": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    },
    "socket_questions": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    }
  },
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000]+$"
    },
    "wireColors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L1", "L2", "L3", "PE", "control"],
      "properties": {
        "L1": { "const": "brown" },
        "L2": { "const": "black" },
        "L3": { "const": "gray" },
        "PE": { "const": "green" },
        "control": { "const": "yellow" }
      }
    }
  }
}

