{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "board_id", "width", "height", "routing_margin", "items", "routing_channels", "forbidden_areas"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "board_id": { "type": "string", "minLength": 1 },
    "width": { "type": "number", "exclusiveMinimum": 0 },
    "height": { "type": "number", "exclusiveMinimum": 0 },
    "routing_margin": { "type": "number", "minimum": 0 },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } },
    "routing_channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
    "forbidden_areas": { "type": "array", "items": { "$ref": "#/$defs/forbidden" } }
  },
  "$defs": {
    "rect": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "pin": {
      "type": "object", "additionalProperties": false,
      "required": ["terminal_id", "label", "number", "side", "x", "y", "max_connections", "enabled"],
      "properties": {
        "terminal_id": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:[-_][A-Za-z0-9]+)*$" },
        "label": { "type": "string" }, "role_label": { "type": ["string", "null"] }, "number": { "type": ["integer", "null"], "minimum": 1 },
        "side": { "enum": ["top", "bottom"] }, "x": { "type": "number" }, "y": { "type": "number" },
        "max_connections": { "type": "integer", "minimum": 1, "maximum": 10 }, "enabled": { "type": "boolean" }
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "label", "item_type", "socket_type_id", "row", "x", "y", "width", "height", "pins", "label_area"],
      "properties": {
        "item_id": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:[-_][A-Za-z0-9]+)*$" },
        "label": { "type": "string" }, "item_type": { "enum": ["socket_8p", "socket_12p", "terminal_block", "component"] },
        "socket_type_id": { "type": ["string", "null"] }, "row": { "type": "integer", "minimum": 0 },
        "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 },
        "pins": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pin" } }, "label_area": { "$ref": "#/$defs/rect" }
      }
    },
    "channel": {
      "type": "object", "additionalProperties": false,
      "required": ["channel_id", "channel_type", "x", "y", "width", "height"],
      "properties": {
        "channel_id": { "type": "string" }, "channel_type": { "enum": ["horizontal", "left_outer", "right_outer"] },
        "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "forbidden": {
      "type": "object", "additionalProperties": false,
      "required": ["area_id", "x", "y", "width", "height"],
      "properties": { "area_id": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }
    }
  }
}
