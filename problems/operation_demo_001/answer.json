  "operation_tests": [
    {
      "test_id": "SELF_HOLD_START_STOP",
      "label": "자기유지 기동·정지",
      "steps": [
        {
          "action": "set_power",
          "value": true,
          "expect": {
            "powered": true,
            "coils": {
              "MC1-COIL": false
            }
          }
        },
        {
          "action": "press_control",
          "control_id": "PB1",
          "expect": {
            "coils": {
              "MC1-COIL": true,
              "T1-COIL": true
            },
            "motors": {
              "M1": "forward"
            }
          }
        },
        {
          "action": "release_control",
          "control_id": "PB1",
          "expect": {
            "coils": {
              "MC1-COIL": true
            }
          }
        },
        {
          "action": "press_control",
          "control_id": "PB0",
          "expect": {
            "coils": {
              "MC1-COIL": false,
              "T1-COIL": false
            },
            "motors": {
              "M1": "stopped"
            }
          }
        }
      ]
    },
    {
      "test_id": "TIMER_INDICATOR",
      "label": "타이머 완료·표시등",
      "steps": [
        {
          "action": "set_power",
          "value": true
        },
        {
          "action": "press_control",
          "control_id": "PB1"
        },
        {
          "action": "release_control",
          "control_id": "PB1"
        },
        {
          "action": "advance_time",
          "milliseconds": 1000,
          "expect": {
            "timers": {
              "T1": {
                "status": "completed"
              }
            },
            "indicators": {
              "GL": "on"
            }
          }
        },
        {
          "action": "set_power",
          "value": false,
          "expect": {
            "powered": false,
            "indicators": {
              "GL": "off"
            },
            "motors": {
              "M1": "stopped"
            }
          }
        }
      ]
    }
  ]
